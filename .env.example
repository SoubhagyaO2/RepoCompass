# Copy to backend/.env and adjust. Never commit the real .env.

# Where cloned repositories and index data are stored (relative to backend/).
REPOCOMPASS_DATA_DIR=data

# The answer layer. The key lives in backend/.env only; leave it empty to run evidence-only.
REPOCOMPASS_LLM_PROVIDER=gemini
# The model all published results were measured with. Results are specific to it.
REPOCOMPASS_GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# The index the API and the MCP server serve (build it first: see the README).
REPOCOMPASS_LIVE_REPOSITORY=
REPOCOMPASS_LIVE_ROOT=

# Connect a repository from the UI (the API clones public GitHub repositories and indexes them).
# Meant for local or trusted use: set to false on any server that untrusted people can reach.
REPOCOMPASS_ENABLE_REPO_INDEXING=true
